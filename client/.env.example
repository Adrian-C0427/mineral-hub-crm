# Base URL of the API. In dev, leave blank to use the Vite proxy (/api -> localhost:4000).
# In production (Railway), set to the API service's public URL, e.g. https://mineral-hub-api-production.up.railway.app
VITE_API_BASE=

# Dev-only: where the Vite proxy forwards /api
VITE_PROXY_TARGET=http://localhost:4000

# --- Error monitoring (Sentry) ---
# Browser DSN, from Sentry > Settings > Projects > mineral-hub-web > Client Keys.
# NOTE: Vite inlines VITE_* at BUILD time. If this is unset when the bundle is
# built, the Sentry.init block in src/main.tsx is dead-code-eliminated and
# @sentry/react is tree-shaken out entirely — the app then reports nothing, with
# no runtime error. Setting this on an already-built service is not enough; the
# client must be REBUILT for it to take effect.
VITE_SENTRY_DSN=

# Source-map upload, so production stack traces are un-minified rather than
# pointing at bundled gibberish. Build-time only (never exposed to the browser)
# and optional — builds succeed without it, see vite.config.ts.
# SENTRY_ORG=
# SENTRY_PROJECT=
# SENTRY_AUTH_TOKEN=
